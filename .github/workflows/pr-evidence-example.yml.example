# SECURITY-FIRST example: opt in by renaming to .yml only after reviewing.
# No privileged trigger. No repository script, package install or code from PR is executed.
# The tool is installed from the trusted BASE branch, not from PR HEAD.
name: RAEE-Lite read-only PR evidence
on:
  pull_request:
    types: [opened, synchronize, reopened]
permissions:
  contents: read
jobs:
  compare:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      PYTHONNOUSERSITE: '1'
    steps:
      - name: Checkout trusted base
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: base
          persist-credentials: false
      - name: Checkout untrusted head AS DATA
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          path: head
          persist-credentials: false
      - name: Setup Python
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.11'
      - name: Install audited code from trusted base only
        run: python -m pip install --no-deps ./base
      - name: Generate read-only snapshots (NO --run)
        run: |
          raee-lite --project base check
          raee-lite --project head check
      - name: Compare reported evidence, check expected commits
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          raee-lite --project head compare --base base/.raee/report.json --head head/.raee/report.json \
            --out head/.raee --expected-base-sha "$BASE_SHA" --expected-head-sha "$HEAD_SHA" \
            --fail-on-regression
      - name: Upload evidence artifact
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: raee-pr-evidence
          path: |
            head/.raee/pr-diff.*
            head/.raee/report.html
            base/.raee/report.html
          if-no-files-found: ignore
