# v0.8 REFERENCE ONLY. Enable AFTER protecting 'main', reviewing all action versions,
# pinning action revisions to immutable vetted SHAs, and testing in a disposable repo.
# The signature proves GitHub workflow provenance, NOT code correctness.
name: RAEE trusted evidence
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions: {}
concurrency:
  group: trusted-evidence-${{ github.ref }}
  cancel-in-progress: false
jobs:
  collect:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1; persist-credentials=false
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.11'
      - name: Install trusted branch code (NOT on PR)
        run: |
          python -m pip install ".[attest]"
          python -m pip check
      - name: Execute explicitly approved regression check
        run: |
          raee-lite init
          raee-lite add "Regression suite executes successfully"
          raee-lite expect --for R1 --kind unit
          raee-lite run --for R1 --kind unit --allow-ci-execution -- python scripts/run_reviewed_suite.py --require-critical-modules
          raee-lite report
        env:
          CI: 'true'
      - name: Export bounded CI claim (NOT yet authenticated)
        env:
          CI: 'true'
          GITHUB_ACTIONS: 'true'
        run: |
          raee-lite ci-export \
            --expected-repo "$GITHUB_REPOSITORY" \
            --trusted-ref refs/heads/main \
            --workflow .github/workflows/trusted-evidence.yml
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: raee-ci-evidence-claim
          path: .raee/ci-evidence.json
          if-no-files-found: error
          retention-days: 30
  sign:
    needs: collect
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      # Pin each of these tags to reviewed full SHAs before production use.
      # No checkout and no repository-owned scripts in this privileged job.
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: raee-ci-evidence-claim
          path: signed
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-path: signed/ci-evidence.json
